NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Extra hosts (comma separated) that product photos are served from, e.g. your S3/R2/CDN domain. Unsplash and the API host are always allowed.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.com
# Set to false on a deployment that has not run the API's seed:demo (hides the demo links and one-click demo sign-in).
# NEXT_PUBLIC_DEMO_ENABLED=false
